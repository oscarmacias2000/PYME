# Copia este archivo a .env y ajusta los valores.

# Puerto del servidor (coincide con la config de Nginx/DuckDNS).
PORT=3000

# Secreto para firmar los JWT. CAMBIALO por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vigencia del token.
JWT_EXPIRES=7d

# Origenes permitidos para CORS (separados por coma). Usa * para permitir todos.
# Ej: https://synclabs.vercel.app,http://localhost:8081
CORS_ORIGIN=*
