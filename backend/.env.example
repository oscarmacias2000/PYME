# Copia este archivo a .env y ajusta los valores.

# Puerto del servidor (coincide con la config de Nginx/DuckDNS).
PORT=3000

# Secreto para firmar los JWT. CAMBIALO por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vigencia del token.
JWT_EXPIRES=7d

# Origenes permitidos para CORS (separados por coma). Usa * para permitir todos.
# Ej: https://synclabs.vercel.app,http://localhost:8081
CORS_ORIGIN=*

# Base de documentacion de servicios (Postgres aislado en Docker).
# docker compose usa las DOCS_DB_*; el backend se conecta con DOCS_DATABASE_URL.
# Sin DOCS_DATABASE_URL el sidebar usa su contenido fijo.
DOCS_DB_NAME=buildwise_docs
DOCS_DB_USER=buildwise
DOCS_DB_PASSWORD=demo123
DOCS_DB_PORT=5433
DOCS_DATABASE_URL=postgres://buildwise:demo123@127.0.0.1:5433/buildwise_docs
