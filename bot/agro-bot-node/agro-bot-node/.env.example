# Copia este archivo a ".env" y llena tus valores reales. Nunca subas el ".env" real a git.

# --- Servidor ---
PORT=3000
# Zona horaria para el resumen diario (IANA tz name)
TIMEZONE=America/Mazatlan
# Hora del resumen diario en formato cron (por defecto 8:00 PM todos los dias)
RESUMEN_CRON=0 20 * * *
# Hora del resumen semanal (por defecto domingo 8:00 PM; el "0" al final es domingo)
RESUMEN_SEMANAL_CRON=0 20 * * 0

# --- Gemini ---
# Genera tu key en https://aistudio.google.com/apikey
# Si tu key empieza con "AQ." usa el header x-goog-api-key (ya viene asi en el codigo).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Google Sheets (cuenta de servicio) ---
# 1) Crea una cuenta de servicio en Google Cloud Console, activa la API de Sheets.
# 2) Descarga el JSON de credenciales y copia aqui el email y la private key.
# 3) Comparte AMBAS hojas de calculo (Reporte de Campo y Actividades Diarias) con ese email, como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

SHEET_REPORTE_CAMPO_ID=1rledplnYjPDTT_OgLTyNaXvSQS7Cn43v
SHEET_REPORTE_CAMPO_TAB=Rendimiento Diario Jornal

SHEET_ACTIVIDADES_ID=1pfSx99JEkGRDC9sRLdu6CkYjeS-SczwjlVrpc9bqATA
SHEET_ACTIVIDADES_TAB=Actividades Diarias

# Maquinaria e Insumos van en pestañas nuevas DENTRO del mismo archivo de Reporte de Campo
# (SHEET_REPORTE_CAMPO_ID de arriba), asi que solo hace falta el nombre de la pestaña.
SHEET_MAQUINARIA_TAB=Maquinaria
SHEET_INSUMOS_TAB=Insumos

# --- Gmail (envio del resumen y alertas de incidencia) ---
# Forma mas simple para un prototipo: activa verificacion en 2 pasos en la cuenta de Gmail
# y genera una "contrasena de aplicacion" en https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
CORREO_DESTINO=fernandovilla200215@gmail.com

# --- WhatsApp / Meta Graph API ---
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=agroPYME2026secreto
WHATSAPP_GRAPH_VERSION=v20.0
# phone_number_id y numero destino para el resumen diario por WhatsApp (opcional)
WHATSAPP_RESUMEN_PHONE_NUMBER_ID=
WHATSAPP_RESUMEN_NUMERO_DESTINO=
